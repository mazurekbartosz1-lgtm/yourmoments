{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/prompts",
      "destination": "/api/index"
    },
    {
      "source": "/prompts/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|\\.well-known/|assets/|pwa-|apple-touch-icon|favicon|manifest\\.webmanifest|sw\\.js|workbox-).*)",
      "destination": "/index.html"
    }
  ]
}

