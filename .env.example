# VITE_FIREBASE_API_KEY: Firebase Web API Key (Configure in Vercel Environment Variables after rotating key in Google Cloud Console)
VITE_FIREBASE_API_KEY="YOUR_ROTATED_FIREBASE_API_KEY"

# Optional Firebase overrides (defaults are read from firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0751515487"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0751515487.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="ai-studio-5c045b1d-7712-4ffc-83a5-148349066838"
VITE_FIREBASE_APP_ID="1:763127306240:web:3759ea8cb6262fa97560e5"

# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/fix-spelling, /api/dynamic-hints, /api/sparkle-summary, /api/translate-share)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://www.dailymoments.app)
APP_URL="https://www.dailymoments.app"

# DOOP_API_KEY: API key for Doop API 1080x1080 Instagram image generation (/api/admin/campaign/generate)
DOOP_API_KEY="YOUR_DOOP_API_KEY"
DOOP_API_URL="https://api.doop.ai/v1/images/generate"
